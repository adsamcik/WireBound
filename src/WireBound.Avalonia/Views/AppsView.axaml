<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WireBound.Avalonia.Controls"
             xmlns:vm="using:WireBound.Avalonia.ViewModels"
             x:Class="WireBound.Avalonia.Views.AppsView"
             x:DataType="vm:AppsViewModel"
             Background="{StaticResource BackgroundBrush}"
             AutomationProperties.Name="Processes">

    <UserControl.Styles>
        <!-- Scope is a mutually exclusive choice, so it reads as a compact
             segmented control rather than an unrelated checkbox. -->
        <Style Selector="ToggleButton.ProcessScope">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.ProcessScope:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource FlyoutItemHoverBrush}" />
        </Style>
        <Style Selector="ToggleButton.ProcessScope:checked">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.ProcessScope:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBgTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Every header cell is the sort target. Hover and active treatments
             make the interaction discoverable without a tiny arrow target. -->
        <Style Selector="Button.SortHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.SortHeader:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource FlyoutItemHoverBrush}" />
        </Style>
        <Style Selector="Button.SortHeader.active">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        </Style>
        <Style Selector="Button.SortHeader.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBgTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Styles>

    <!-- The process list owns the only vertical scroll viewport. Everything
         above it is a compact command surface, keeping virtualization intact. -->
    <Grid Margin="20"
          RowDefinitions="Auto, *"
          RowSpacing="10">

        <!-- One concise information band replaces the page introduction,
             telemetry card, and five separate summary cards. -->
        <Border Classes="SubtleCard" Padding="14,10">
            <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, *, Auto"
                  ColumnSpacing="16">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <TextBlock Text="Processes"
                               FontSize="26"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <Border Background="{StaticResource AccentBgTintBrush}"
                            CornerRadius="999"
                            Padding="8,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{Binding ProcessCount}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Text="running"
                                       FontSize="11"
                                       Foreground="{StaticResource PrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="1"
                        Height="28"
                        Background="{StaticResource DividerBrush}"
                        VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="CPU" Classes="MetricLabel" FontSize="10" />
                    <TextBlock Text="{Binding TotalCpu}"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{StaticResource CpuBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="MEMORY" Classes="MetricLabel" FontSize="10" />
                    <TextBlock Text="{Binding TotalMemory}"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{StaticResource MemoryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="1">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <controls:WbIcon IconKey="WbMetricDownload" Width="11" Height="11" />
                        <TextBlock Text="DOWN" Classes="MetricLabel" FontSize="10" />
                    </StackPanel>
                    <TextBlock Text="{Binding TotalDownloadSpeed}"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{StaticResource DownloadBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="5" VerticalAlignment="Center" Spacing="1">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <controls:WbIcon IconKey="WbMetricUpload" Width="11" Height="11" />
                        <TextBlock Text="UP" Classes="MetricLabel" FontSize="10" />
                    </StackPanel>
                    <TextBlock Text="{Binding TotalUploadSpeed}"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{StaticResource UploadBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="7"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Network values become available when per-process telemetry is supported">
                    <ProgressBar IsIndeterminate="True"
                                 Width="32"
                                 Height="3"
                                 IsVisible="{Binding IsLoading}"
                                 AutomationProperties.Name="Refreshing process usage" />
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{StaticResource SuccessBrush}"
                             IsVisible="{Binding HasNetworkData}" />
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{StaticResource MutedTextBrush}"
                             IsVisible="{Binding !HasNetworkData}" />
                    <TextBlock Text="{Binding LastUpdatedLabel}"
                               Classes="Caption"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search, filtering, sorting, and rows belong to one table surface. -->
        <Border Grid.Row="1"
                Classes="Card"
                Padding="0"
                MinHeight="0"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto, *" MinHeight="0">
                <Border Padding="12,10"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*, Auto, Auto, Auto"
                          ColumnSpacing="10">
                        <Grid MinWidth="260">
                            <TextBox Text="{Binding SearchText}"
                                     PlaceholderText="Search name, PID, or executable path"
                                     MinHeight="40"
                                     Padding="38,8,40,8"
                                     Background="{StaticResource SurfaceBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     BorderThickness="1"
                                     CornerRadius="8"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="Search processes"
                                     AutomationProperties.HelpText="Filter running processes by display name, process name, process ID, or executable path" />
                            <controls:WbIcon IconKey="WbActionSearch"
                                             Width="15"
                                             Height="15"
                                             Margin="13,0,0,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             IsHitTestVisible="False" />
                            <Button Classes="Ghost"
                                    Command="{Binding ClearSearchCommand}"
                                    IsVisible="{Binding HasSearchText}"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    Margin="0,2,2,2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Clear search"
                                    AutomationProperties.Name="Clear process search">
                                <TextBlock Text="×" FontSize="18" FontWeight="Normal" />
                            </Button>
                        </Grid>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding VisibleProcessCount, StringFormat='{}{0} shown'}"
                                   Classes="Caption"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding HasActiveProcessFilter}" />

                        <Border Grid.Column="2"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="2">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <ToggleButton Classes="ProcessScope"
                                              IsChecked="{Binding IsAllProcessesScope, Mode=OneWay}"
                                              Command="{Binding ShowAllProcessesCommand}"
                                              AutomationProperties.Name="Show all processes"
                                              AutomationProperties.HelpText="Include user applications, background services, and system processes">
                                    <TextBlock Text="All" />
                                </ToggleButton>
                                <ToggleButton Classes="ProcessScope"
                                              IsChecked="{Binding IsUserProcessesScope, Mode=OneWay}"
                                              Command="{Binding ShowUserProcessesCommand}"
                                              AutomationProperties.Name="Show user processes only"
                                              AutomationProperties.HelpText="Hide operating system and background processes">
                                    <TextBlock Text="User only" />
                                </ToggleButton>
                            </StackPanel>
                        </Border>

                        <Button Grid.Column="3"
                                Classes="Secondary"
                                Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding !IsLoading}"
                                Width="40"
                                Height="40"
                                Padding="0"
                                ToolTip.Tip="Refresh now"
                                AutomationProperties.Name="Refresh process usage"
                                AutomationProperties.HelpText="Take a new snapshot of process CPU, memory, and network usage">
                            <controls:WbIcon IconKey="WbActionRefresh" Width="15" Height="15" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Header and rows share one horizontal viewport, so their
                     repeated column definitions remain aligned when narrow. -->
                <ScrollViewer Grid.Row="1"
                              MinHeight="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <Grid MinWidth="930"
                          MinHeight="0"
                          RowDefinitions="Auto, *">
                <!-- Header cells fill their complete columns. The selected sort
                     receives a persistent tint; arrows only communicate direction. -->
                <Border Grid.Row="0"
                        Background="{StaticResource BorderSubtleBrush}"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="8,2">
                    <Grid ColumnDefinitions="*, 92, 128, 120, 120, 120"
                          ColumnSpacing="4">
                        <Button Classes="SortHeader"
                                Classes.active="{Binding IsNameSort}"
                                HorizontalContentAlignment="Left"
                                Command="{Binding ToggleSortCommand}"
                                CommandParameter="{x:Static vm:ProcessUsageSortColumn.Name}"
                                AutomationProperties.Name="Sort processes by name"
                                AutomationProperties.HelpText="Sort the running process table by application or process name">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="PROCESS" />
                                <TextBlock Text="{Binding NameSortGlyph}" FontSize="9" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1"
                                Classes="SortHeader"
                                Classes.active="{Binding IsCpuSort}"
                                HorizontalContentAlignment="Right"
                                Command="{Binding ToggleSortCommand}"
                                CommandParameter="{x:Static vm:ProcessUsageSortColumn.Cpu}"
                                AutomationProperties.Name="Sort processes by CPU"
                                AutomationProperties.HelpText="Sort the running process table by current CPU usage">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="CPU" />
                                <TextBlock Text="{Binding CpuSortGlyph}" FontSize="9" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Classes="SortHeader"
                                Classes.active="{Binding IsMemorySort}"
                                HorizontalContentAlignment="Right"
                                Command="{Binding ToggleSortCommand}"
                                CommandParameter="{x:Static vm:ProcessUsageSortColumn.Memory}"
                                AutomationProperties.Name="Sort processes by memory"
                                AutomationProperties.HelpText="Sort the running process table by physical memory usage">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="MEMORY" />
                                <TextBlock Text="{Binding MemorySortGlyph}" FontSize="9" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3"
                                Classes="SortHeader"
                                Classes.active="{Binding IsDownloadSort}"
                                HorizontalContentAlignment="Right"
                                Command="{Binding ToggleSortCommand}"
                                CommandParameter="{x:Static vm:ProcessUsageSortColumn.Download}"
                                AutomationProperties.Name="Sort processes by download speed"
                                AutomationProperties.HelpText="Sort the running process table by current download speed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="DOWNLOAD" />
                                <TextBlock Text="{Binding DownloadSortGlyph}" FontSize="9" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4"
                                Classes="SortHeader"
                                Classes.active="{Binding IsUploadSort}"
                                HorizontalContentAlignment="Right"
                                Command="{Binding ToggleSortCommand}"
                                CommandParameter="{x:Static vm:ProcessUsageSortColumn.Upload}"
                                AutomationProperties.Name="Sort processes by upload speed"
                                AutomationProperties.HelpText="Sort the running process table by current upload speed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="UPLOAD" />
                                <TextBlock Text="{Binding UploadSortGlyph}" FontSize="9" />
                            </StackPanel>
                        </Button>
                        <Border Grid.Column="5" Padding="10,8">
                            <TextBlock Text="SESSION"
                                       Classes="MetricLabel"
                                       FontSize="11"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- The list keeps its own finite vertical viewport so row
                     virtualization remains active. -->
                    <Grid Grid.Row="1" MinHeight="0">
                        <ListBox ItemsSource="{Binding ProcessItems}"
                                 SelectionMode="Single"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MinHeight="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Running processes"
                                 AutomationProperties.HelpText="Virtualized list of processes with live CPU, memory, and network usage">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:selected Border.ProcessRow">
                                    <Setter Property="Background" Value="{StaticResource SelectionBgBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProcessUsageDisplayItem">
                                    <Border Classes="ProcessRow"
                                            Background="Transparent"
                                            BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="12,4"
                                            Height="52"
                                            ToolTip.Tip="{Binding ExecutablePath}"
                                            AutomationProperties.Name="{Binding DisplayName}"
                                            AutomationProperties.HelpText="{Binding ExecutablePath}">
                                        <Border.Styles>
                                            <Style Selector="Border:pointerover">
                                                <Setter Property="Background" Value="{StaticResource FlyoutItemHoverBrush}" />
                                            </Style>
                                        </Border.Styles>
                                        <Grid ColumnDefinitions="*, 92, 128, 120, 120, 120"
                                              ColumnSpacing="4">
                                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="9">
                                                <Border Width="30"
                                                        Height="30"
                                                        CornerRadius="7"
                                                        Background="{StaticResource AccentBgTintBrush}">
                                                    <controls:WbIcon IconKey="WbEntityApp" Width="15" Height="15" />
                                                </Border>
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Spacing="0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <TextBlock Text="{Binding ProcessName}"
                                                                   Classes="Caption"
                                                                   FontSize="10"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="180" />
                                                        <TextBlock Text="•" Classes="Caption" FontSize="10" />
                                                        <TextBlock Text="{Binding ProcessId, StringFormat='PID {0}'}"
                                                                   Classes="Caption"
                                                                   FontSize="10" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Column="2"
                                                        Background="{StaticResource BorderSubtleBrush}"
                                                        CornerRadius="999"
                                                        Padding="6,2"
                                                        Margin="6,0"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding IsSystemProcess}">
                                                    <TextBlock Text="SYSTEM"
                                                               FontSize="8"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CpuDisplay}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource CpuBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       ToolTip.Tip="CPU usage; a dash means the first sample is pending" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding MemoryDisplay}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource MemoryBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding MemoryDisplay}" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding DownloadDisplay}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource DownloadBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       ToolTip.Tip="A dash means per-process network telemetry is unavailable" />
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding UploadDisplay}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource UploadBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       ToolTip.Tip="A dash means per-process network telemetry is unavailable" />
                                            <TextBlock Grid.Column="5"
                                                       Text="{Binding SessionTotalDisplay}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding SessionTotalDisplay}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Background="{StaticResource CardBrush}"
                                IsVisible="{Binding !HasVisibleProcesses}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8"
                                        MaxWidth="380">
                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="12"
                                        Background="{StaticResource AccentBgTintBrush}"
                                        HorizontalAlignment="Center">
                                    <controls:WbIcon IconKey="WbEntityApp" Width="22" Height="22" />
                                </Border>
                                <TextBlock Text="No matching processes"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Clear the search or switch the scope to All."
                                           Classes="Subtitle"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center" />
                                <Button Classes="Secondary ToolbarButton"
                                        Command="{Binding ClearSearchCommand}"
                                        IsVisible="{Binding HasSearchText}"
                                        AutomationProperties.Name="Clear process search from empty state">
                                    <TextBlock Text="Clear search" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
