<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WireBound.Avalonia.ViewModels"
        xmlns:controls="using:WireBound.Avalonia.Controls"
        xmlns:core="using:WireBound.Core"
        x:Class="WireBound.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="WireBound"
        Icon="avares://WireBound/Assets/wirebound.ico"
        AutomationProperties.Name="WireBound system monitor"
        Width="1360" Height="900"
        MinWidth="900" MinHeight="650"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.BottomNavCard">
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Background" Value="{StaticResource RailBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="BoxShadow" Value="0 4 14 0 #40000000" />
        </Style>
        <Style Selector="Border.BottomNavCard.selected">
            <Setter Property="Background" Value="{StaticResource SelectionBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DownloadBrush}" />
        </Style>
        <Style Selector="Border.BottomNavCard Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.BottomNavCard Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource FlyoutItemHoverColor}" />
        </Style>
        <Style Selector="Button.HeaderAction">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.HeaderAction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource FlyoutItemHoverColor}" />
        </Style>
        <Style Selector="Button.HeaderAction.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SelectionBgBrush}" />
        </Style>
    </Window.Styles>

    <Grid x:Name="RootGrid" RowDefinitions="60,*,Auto">
        <Border Grid.Row="0"
                Background="{StaticResource RailBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="22,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="34" Height="34"
                            Background="{StaticResource DownloadBgTintBrush}"
                            BorderBrush="{StaticResource DownloadBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <controls:WbIcon IconKey="WbBrandWireBound" Width="22" Height="22" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WireBound" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Version}" Classes="Caption" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                Spacing="7"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsMonitoringActive}"
                                AutomationProperties.Name="{Binding MonitoringStatusAutomationName}">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" />
                        <TextBlock Text="Live" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Spacing="7"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !IsMonitoringActive}"
                                AutomationProperties.Name="{Binding MonitoringStatusAutomationName}">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="Waiting" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                    <Border Width="1" Height="28" Background="{StaticResource DividerBrush}" Margin="4,0" />
                    <Grid>
                        <Button Classes="HeaderAction"
                                Classes.selected="{Binding IsSettingsSelected}"
                                Command="{Binding NavigateToCommand}"
                                CommandParameter="{x:Static core:Routes.Settings}"
                                ToolTip.Tip="Settings"
                                AutomationProperties.Name="Open Settings">
                            <controls:WbIcon IconKey="WbNavSettings" Width="20" Height="20" />
                        </Button>
                        <Ellipse Width="8" Height="8"
                                 Fill="{StaticResource AccentBrush}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,4,4,0"
                                 IsVisible="{Binding SettingsHasBadge}"
                                 AutomationProperties.Name="Update available" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentView}"
                        AutomationProperties.Name="Main content area"
                        AutomationProperties.HelpText="Displays the selected monitoring surface" />

        <Grid Grid.Row="2"
              Margin="24,10,24,16"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="16">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                <Border Classes="BottomNavCard"
                        Classes.selected="{Binding IsOverviewSelected}">
                    <Button Command="{Binding NavigateToCommand}"
                            CommandParameter="{x:Static core:Routes.Overview}"
                            AutomationProperties.Name="Open Overview">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <controls:WbIcon IconKey="WbNavOverview" Width="21" Height="21" />
                            <TextBlock Text="Overview" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Border>

                <Border Classes="BottomNavCard"
                        Classes.selected="{Binding IsProcessesSelected}">
                    <Button Command="{Binding NavigateToCommand}"
                            CommandParameter="{x:Static core:Routes.Apps}"
                            AutomationProperties.Name="Open Processes">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <controls:WbIcon IconKey="WbNavApps" Width="21" Height="21" />
                            <TextBlock Text="Processes" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Border>

                <Border Classes="BottomNavCard"
                        Classes.selected="{Binding IsConnectionsSelected}">
                    <Button Command="{Binding NavigateToCommand}"
                            CommandParameter="{x:Static core:Routes.Connections}"
                            AutomationProperties.Name="Open Connections">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <controls:WbIcon IconKey="WbNavConnections" Width="21" Height="21" />
                            <TextBlock Text="Connections" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Border>
            </StackPanel>

            <Border Grid.Column="2"
                    IsVisible="{Binding IsDashboardRoute}"
                    Height="58"
                    Background="{StaticResource RailBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="10"
                    BoxShadow="0 4 14 0 #40000000"
                    AutomationProperties.Name="Dashboard view controls">
                <Grid>
                    <StackPanel x:Name="ExpandedFilterControls" Orientation="Horizontal" Spacing="8">
                        <ComboBox Width="94"
                                  ItemsSource="{Binding Dashboard.TimeRangeOptions}"
                                  SelectedItem="{Binding Dashboard.SelectedTimeRangeOption}"
                                  AutomationProperties.Name="Time range">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TimeRangeDisplayItem">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Width="150"
                                  ItemsSource="{Binding Dashboard.SignalOptions}"
                                  SelectedItem="{Binding Dashboard.SelectedSignal}"
                                  AutomationProperties.Name="Resource signal" />
                        <ComboBox Width="142"
                                  ItemsSource="{Binding Dashboard.ProcessScopeOptions}"
                                  SelectedItem="{Binding Dashboard.SelectedProcessScope}"
                                  AutomationProperties.Name="Process scope" />
                        <Button Classes="Secondary ToolbarButton"
                                Padding="12,8"
                                Command="{Binding Dashboard.ToggleFiltersCommand}"
                                AutomationProperties.Name="Toggle dashboard filters">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <controls:WbIcon IconKey="WbActionTune" Width="15" Height="15" />
                                <TextBlock Text="Filters" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Button x:Name="CompactViewButton"
                            IsVisible="False"
                            Classes="Secondary ToolbarButton"
                            Padding="14,8"
                            Command="{Binding Dashboard.ToggleFiltersCommand}"
                            AutomationProperties.Name="Open view controls">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:WbIcon IconKey="WbActionTune" Width="16" Height="16" />
                            <TextBlock Text="View" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
