<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WireBound.Avalonia.ViewModels"
             x:Class="WireBound.Avalonia.Views.AppsView" x:DataType="vm:AppsViewModel"
             Background="{StaticResource BackgroundBrush}" AutomationProperties.Name="Processes">
    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Processes" Classes="PageTitle" />
            <TextBlock Grid.Column="1" Text="{Binding LastUpdatedLabel}" Classes="Caption" VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Row="1" Classes="Card" Padding="16,12">
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                <StackPanel Spacing="3"><TextBlock Text="CPU" Classes="MetricLabel" /><TextBlock Text="{Binding TotalCpu}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource CpuBrush}" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="RAM IN USE" Classes="MetricLabel" /><TextBlock Text="{Binding TotalMemory}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource MemoryBrush}" /></StackPanel>
                <StackPanel Grid.Column="2" Spacing="3"><TextBlock Text="DOWNLOAD" Classes="MetricLabel" /><TextBlock Text="{Binding TotalDownloadSpeed}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource DownloadBrush}" /></StackPanel>
                <StackPanel Grid.Column="3" Spacing="3"><TextBlock Text="UPLOAD" Classes="MetricLabel" /><TextBlock Text="{Binding TotalUploadSpeed}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource UploadBrush}" /></StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Classes="SubtleCard" Padding="10">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <TextBox Text="{Binding SearchText}" PlaceholderText="Search name, PID, or path" MinWidth="180" AutomationProperties.Name="Search processes" />
                <CheckBox Grid.Column="1" IsChecked="{Binding ShowSystemProcesses}" VerticalAlignment="Center" Content="Show system" AutomationProperties.Name="Show system processes" />
                <Button Grid.Column="2" Classes="Secondary ToolbarButton" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh processes"><TextBlock Text="Refresh" /></Button>
            </Grid>
        </Border>
        <Border Grid.Row="3" Classes="SubtleCard" Padding="12" IsVisible="{Binding HasContext}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2"><TextBlock Text="{Binding ContextTitle}" FontWeight="SemiBold" /><TextBlock Text="{Binding ContextDetail}" Classes="Caption" TextWrapping="Wrap" /></StackPanel>
                <CheckBox Grid.Column="1" IsChecked="{Binding IncludeLikelyMatches}" Content="Include likely matches" VerticalAlignment="Center" AutomationProperties.Name="Include likely matches" />
                <Button Grid.Column="2" Classes="Ghost" Command="{Binding BackToMemoryCommand}" AutomationProperties.Name="Back to Memory"><TextBlock Text="Back to Memory" /></Button>
                <Button Grid.Column="3" Classes="Ghost" Command="{Binding ClearContextCommand}" AutomationProperties.Name="Clear process context"><TextBlock Text="Clear" /></Button>
            </Grid>
        </Border>
        <Border Grid.Row="4" Classes="Card" Padding="0" MinHeight="0" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*" MinHeight="0">
                <Grid Margin="18,12" ColumnDefinitions="*,Auto"><TextBlock Text="Running processes" Classes="SectionHeader" /><TextBlock Grid.Column="1" Text="{Binding VisibleProcessCount, StringFormat='{}{0} shown'}" Classes="Caption" VerticalAlignment="Center" /></Grid>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MinHeight="0">
                    <Grid MinWidth="800" RowDefinitions="Auto,*" MinHeight="0">
                        <Border Background="{StaticResource BorderSubtleBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,1" Padding="18,9">
                            <Grid ColumnDefinitions="*,90,125,115,115" ColumnSpacing="12">
                                <Button Classes="Ghost" Padding="0" HorizontalAlignment="Left" Command="{Binding ToggleSortCommand}" CommandParameter="{x:Static vm:ProcessUsageSortColumn.Name}" AutomationProperties.Name="Sort by name"><TextBlock Text="NAME" Classes="MetricLabel" /></Button>
                                <Button Grid.Column="1" Classes="Ghost" Padding="0" HorizontalAlignment="Right" Command="{Binding ToggleSortCommand}" CommandParameter="{x:Static vm:ProcessUsageSortColumn.Cpu}" AutomationProperties.Name="Sort by CPU"><TextBlock Text="CPU" Classes="MetricLabel" /></Button>
                                <Button Grid.Column="2" Classes="Ghost" Padding="0" HorizontalAlignment="Right" Command="{Binding ToggleSortCommand}" CommandParameter="{x:Static vm:ProcessUsageSortColumn.Memory}" AutomationProperties.Name="Sort by resident RAM"><TextBlock Text="RESIDENT RAM" Classes="MetricLabel" /></Button>
                                <Button Grid.Column="3" Classes="Ghost" Padding="0" HorizontalAlignment="Right" Command="{Binding ToggleSortCommand}" CommandParameter="{x:Static vm:ProcessUsageSortColumn.Download}" AutomationProperties.Name="Sort by download"><TextBlock Text="DOWNLOAD" Classes="MetricLabel" /></Button>
                                <Button Grid.Column="4" Classes="Ghost" Padding="0" HorizontalAlignment="Right" Command="{Binding ToggleSortCommand}" CommandParameter="{x:Static vm:ProcessUsageSortColumn.Upload}" AutomationProperties.Name="Sort by upload"><TextBlock Text="UPLOAD" Classes="MetricLabel" /></Button>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" MinHeight="0">
                            <ListBox ItemsSource="{Binding ProcessItems}" SelectedItem="{Binding SelectedProcess}" MinHeight="0" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Running processes">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ProcessUsageDisplayItem">
                                    <Border Padding="18,8" Height="56" ToolTip.Tip="{Binding ExecutablePath}" AutomationProperties.Name="{Binding DisplayName}">
                                        <Grid ColumnDefinitions="*,90,125,115,115" ColumnSpacing="12">
                                            <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ProcessIdLabel}" Classes="Caption" /></StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding CpuDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource CpuBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding MemoryDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MemoryBrush}" />
                                            <TextBlock Grid.Column="3" Text="{Binding DownloadDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource DownloadBrush}" />
                                            <TextBlock Grid.Column="4" Text="{Binding UploadDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource UploadBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding EmptyLabel}" Classes="Caption" IsVisible="{Binding !HasVisibleProcesses}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
        <Border Grid.Row="5" Classes="SubtleCard" Padding="14" IsVisible="{Binding HasSelectedProcess}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="18">
                <StackPanel Spacing="3">
                    <TextBlock Text="{Binding SelectedProcess.DisplayName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedProcess.ExecutablePath}" Classes="Caption" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SelectedProcess.LikelyWorkloadLabel}" IsVisible="{Binding SelectedProcess.HasLikelyWorkload}" Classes="Caption" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="PRIVATE COMMITTED" Classes="MetricLabel" />
                    <TextBlock Text="{Binding SelectedProcess.PrivateDisplay}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock Text="RESIDENT RAM" Classes="MetricLabel" />
                    <TextBlock Text="{Binding SelectedProcess.MemoryDisplay}" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
