<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WireBound.Avalonia.ViewModels"
        xmlns:controls="using:WireBound.Avalonia.Controls"
        xmlns:core="using:WireBound.Core"
        x:Class="WireBound.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="WireBound"
        Icon="avares://WireBound/Assets/wirebound.ico"
        AutomationProperties.Name="WireBound system monitor"
        Width="1360" Height="900"
        MinWidth="900" MinHeight="650"
        Background="{StaticResource AppBackdropBrush}"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.HeaderNavCard">
            <Setter Property="MinWidth" Value="116" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.HeaderNavCard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource FlyoutItemHoverColor}" />
        </Style>
        <Style Selector="Button.HeaderNavCard.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SelectionBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.HeaderNavCard TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        </Style>
        <Style Selector="Button.HeaderNavCard.selected TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="Button.HeaderAction">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="Background" Value="{StaticResource SurfaceVariantBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="20" />
        </Style>
        <Style Selector="Button.HeaderAction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource FlyoutItemHoverColor}" />
        </Style>
        <Style Selector="Button.HeaderAction.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SelectionBgBrush}" />
        </Style>
    </Window.Styles>

    <Grid x:Name="RootGrid" RowDefinitions="68,Auto,*,Auto">
        <Border Grid.Row="0"
                Background="{StaticResource RailBackgroundBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <Border Background="{StaticResource SurfaceVariantBrush}"
                        CornerRadius="18"
                        Padding="4"
                        VerticalAlignment="Center"
                        BoxShadow="0 4 14 0 #20000000">
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="HeaderNavCard"
                            Classes.selected="{Binding IsOverviewSelected}"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="{x:Static core:Routes.Overview}"
                            AutomationProperties.Name="Open Overview">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:WbIcon IconKey="WbNavOverview" Width="18" Height="18" />
                            <TextBlock Text="Overview" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="HeaderNavCard"
                            Classes.selected="{Binding IsProcessesSelected}"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="{x:Static core:Routes.Apps}"
                            AutomationProperties.Name="Open Processes">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:WbIcon IconKey="WbNavApps" Width="18" Height="18" />
                            <TextBlock Text="Processes" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="HeaderNavCard"
                            Classes.selected="{Binding IsConnectionsSelected}"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="{x:Static core:Routes.Connections}"
                            AutomationProperties.Name="Open Connections">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:WbIcon IconKey="WbNavConnections" Width="18" Height="18" />
                            <TextBlock Text="Connections" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="{StaticResource SuccessBgTintBrush}"
                            CornerRadius="999"
                            Padding="11,7"
                            IsVisible="{Binding IsMonitoringActive}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="7"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding MonitoringStatusAutomationName}">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" />
                        <TextBlock Text="Live" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceVariantBrush}"
                            CornerRadius="999"
                            Padding="11,7"
                            IsVisible="{Binding !IsMonitoringActive}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="7"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding MonitoringStatusAutomationName}">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="Waiting" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                    </Border>
                    <Grid>
                        <Button Classes="HeaderAction"
                                Classes.selected="{Binding IsSettingsSelected}"
                                Command="{Binding NavigateToCommand}"
                                CommandParameter="{x:Static core:Routes.Settings}"
                                ToolTip.Tip="Settings"
                                AutomationProperties.Name="Open Settings">
                            <controls:WbIcon IconKey="WbNavSettings" Width="20" Height="20" />
                        </Button>
                        <Ellipse Width="8" Height="8"
                                 Fill="{StaticResource AccentBrush}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,4,4,0"
                                 IsVisible="{Binding SettingsHasBadge}"
                                 AutomationProperties.Name="Update available" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="24,12,24,0"
                Padding="14,12"
                IsVisible="{Binding IsHelperStartupDecisionVisible}"
                Background="{StaticResource WarningBgTintBrush}"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="1"
                CornerRadius="9"
                AutomationProperties.Name="Helper autostart setup decision">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <controls:WbIcon IconKey="WbStatusWarning"
                                 Width="20" Height="20"
                                 VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="Finish helper autostart setup" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding HelperStartupDecisionMessage}"
                               Classes="Caption"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding HelperStartupDecisionStatus}"
                               Foreground="{StaticResource WarningBrush}"
                               FontSize="12" />
                </StackPanel>
                <Button Grid.Column="2"
                        Classes="Primary"
                        Padding="14,8"
                        IsEnabled="{Binding !IsHelperStartupDecisionBusy}"
                        Command="{Binding SetUpHelperStartupCommand}"
                        AutomationProperties.Name="Set up helper autostart">
                    <TextBlock Text="Set up" />
                </Button>
                <Button Grid.Column="3"
                        Classes="Secondary"
                        Padding="14,8"
                        IsEnabled="{Binding !IsHelperStartupDecisionBusy}"
                        Command="{Binding DisableHelperStartupCommand}"
                        AutomationProperties.Name="Disable helper autostart">
                    <TextBlock Text="Disable autostart" />
                </Button>
            </Grid>
        </Border>

        <ContentControl Grid.Row="2"
                        Content="{Binding CurrentView}"
                        AutomationProperties.Name="Main content area"
                        AutomationProperties.HelpText="Displays the selected monitoring surface" />

        <Grid Grid.Row="3"
              IsVisible="{Binding IsDashboardRoute}"
              Margin="20,10,20,18"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="16">
            <Border Grid.Column="1"
                    Height="60"
                    Background="{StaticResource SurfaceElevatedBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="8"
                    BoxShadow="0 12 28 0 #40000000"
                    AutomationProperties.Name="Dashboard view controls">
                <Grid>
                    <StackPanel x:Name="ExpandedFilterControls" Orientation="Horizontal" Spacing="8">
                        <ComboBox Width="94"
                                  ItemsSource="{Binding Dashboard.TimeRangeOptions}"
                                  SelectedItem="{Binding Dashboard.SelectedTimeRangeOption}"
                                  AutomationProperties.Name="Time range">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TimeRangeDisplayItem">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Width="150"
                                  IsVisible="{Binding Dashboard.HasSignalChoices}"
                                  ItemsSource="{Binding Dashboard.SignalOptions}"
                                  SelectedItem="{Binding Dashboard.SelectedSignal}"
                                  AutomationProperties.Name="Resource signal" />
                        <ComboBox Width="142"
                                  IsVisible="{Binding Dashboard.HasProcessAttribution}"
                                  ItemsSource="{Binding Dashboard.ProcessScopeOptions}"
                                  SelectedItem="{Binding Dashboard.SelectedProcessScope}"
                                  AutomationProperties.Name="Process scope" />
                        <Button Classes="Secondary ToolbarButton"
                                IsVisible="{Binding Dashboard.HasContextFilters}"
                                Padding="12,8"
                                Command="{Binding Dashboard.ToggleFiltersCommand}"
                                AutomationProperties.Name="Choose network adapter">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <controls:WbIcon IconKey="WbActionTune" Width="15" Height="15" />
                                <TextBlock Text="Adapter" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Button x:Name="CompactViewButton"
                            IsVisible="False"
                            Classes="Secondary ToolbarButton"
                            Padding="14,8"
                            Command="{Binding Dashboard.ToggleFiltersCommand}"
                            AutomationProperties.Name="Open view controls">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:WbIcon IconKey="WbActionTune" Width="16" Height="16" />
                            <TextBlock Text="View" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
