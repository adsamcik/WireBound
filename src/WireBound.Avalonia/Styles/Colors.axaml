<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 
    ═══════════════════════════════════════════════════════════════════════════
    WireBound Design System v3.0 - "Signal & Flow" Theme (Avalonia)
    ═══════════════════════════════════════════════════════════════════════════
    -->
    
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- CORE BACKGROUND COLORS                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    
    <Color x:Key="BackgroundColor">#0B1017</Color>
    <Color x:Key="BackgroundColorDark">#0B1017</Color>
    <Color x:Key="BackgroundColorLight">#F8FAFC</Color>
    
    <Color x:Key="SurfaceColor">#121A24</Color>
    <Color x:Key="SurfaceVariantColor">#161F2A</Color>
    <Color x:Key="SurfaceElevatedColor">#1B2633</Color>
    <Color x:Key="CardColor">#141E29</Color>
    <Color x:Key="CardColorDark">#141E29</Color>
    <Color x:Key="CardColorLight">#FFFFFF</Color>
    <Color x:Key="CardHoverColor">#1C2937</Color>
    
    <Color x:Key="GlassBackground">#D9141E29</Color>
    <Color x:Key="GlassBorder">#14FFFFFF</Color>
    <Color x:Key="GlassHighlight">#0AFFFFFF</Color>
    
    <Color x:Key="RailBackgroundColor">#0E151E</Color>
    <Color x:Key="SidebarColor">#101821</Color>
    
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- BRAND & ACTIVITY COLORS                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    
    <Color x:Key="PrimaryColor">#66D7E5</Color>
    <Color x:Key="PrimaryColorLight">#9AE7EF</Color>
    <Color x:Key="PrimaryColorDark">#319AA9</Color>
    <Color x:Key="OnPrimaryColor">#06171A</Color>
    
    <Color x:Key="SecondaryColor">#F0A384</Color>
    <Color x:Key="SecondaryColorLight">#F7C1AA</Color>
    <Color x:Key="SecondaryColorDark">#C87456</Color>
    
    <Color x:Key="DownloadColor">#66D7E5</Color>
    <Color x:Key="DownloadColorGlow">#8BE4EC</Color>
    <Color x:Key="DownloadColorDim">#319AA9</Color>
    <Color x:Key="UploadColor">#F0A384</Color>
    <Color x:Key="UploadColorGlow">#F7C1AA</Color>
    <Color x:Key="UploadColorDim">#C87456</Color>
    
    <Color x:Key="ChartAccentColor">#F2C66D</Color>
    <Color x:Key="ChartTertiaryColor">#B69AF3</Color>
    
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- SYSTEM METRIC COLORS                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    
    <!-- CPU Colors (Sapphire Blue) -->
    <Color x:Key="CpuColor">#83A9F9</Color>
    <Color x:Key="CpuColorLight">#AFC5FB</Color>
    <Color x:Key="CpuColorDark">#5E83D6</Color>
    <Color x:Key="CpuBgTint">#2683A9F9</Color>

    <!-- Kernel/privileged CPU timing highlight (Amber) -->
    <Color x:Key="KernelColor">#F59E0B</Color>
    <Color x:Key="KernelBgTint">#25F59E0B</Color>
    
    <!-- Memory Colors (Magenta Pink — colorblind-safe vs CPU blue) -->
    <Color x:Key="MemoryColor">#F08BBE</Color>
    <Color x:Key="MemoryColorLight">#F5B3D3</Color>
    <Color x:Key="MemoryColorDark">#C95C91</Color>
    <Color x:Key="MemoryBgTint">#26F08BBE</Color>
    
    <!-- GPU Colors (Emerald Green) -->
    <Color x:Key="GpuColor">#68D6AE</Color>
    <Color x:Key="GpuColorLight">#99E6C9</Color>
    <Color x:Key="GpuColorDark">#3AA27C</Color>
    <Color x:Key="GpuBgTint">#2468D6AE</Color>
    
    <!-- Disk Colors (Amber Gold) -->
    <Color x:Key="DiskColor">#F2C66D</Color>
    <Color x:Key="DiskColorLight">#F7D998</Color>
    <Color x:Key="DiskColorDark">#C99A3F</Color>
    <Color x:Key="DiskBgTint">#26F2C66D</Color>
    
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- TEXT COLORS                                                          -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    
    <Color x:Key="PrimaryTextColor">#F4F7FA</Color>
    <Color x:Key="SecondaryTextColor">#B2BDCA</Color>
    <Color x:Key="MutedTextColor">#7C8998</Color>
    <Color x:Key="DisabledTextColor">#566270</Color>
    
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- STATUS COLORS                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    
    <Color x:Key="SuccessColor">#68D6AE</Color>
    <Color x:Key="SuccessColorLight">#99E6C9</Color>
    <Color x:Key="SuccessColorDark">#3AA27C</Color>
    
    <Color x:Key="WarningColor">#F2C66D</Color>
    <Color x:Key="WarningColorLight">#F7D998</Color>
    <Color x:Key="WarningColorDark">#C99A3F</Color>
    
    <Color x:Key="ErrorColor">#FF8A9A</Color>
    <Color x:Key="ErrorColorLight">#FFB2BC</Color>
    <Color x:Key="ErrorColorDark">#D65B6C</Color>
    
    <Color x:Key="InfoColor">#83A9F9</Color>
    
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- BORDER & DIVIDER COLORS                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    
    <Color x:Key="BorderColor">#263342</Color>
    <Color x:Key="BorderSubtleColor">#1E2935</Color>
    <Color x:Key="DividerColor">#202B37</Color>
    
    <Color x:Key="WireColor">#263342</Color>
    <Color x:Key="WireActiveColor">#66D7E5</Color>
    <Color x:Key="NodeColor">#536273</Color>
    <Color x:Key="NodeActiveColor">#66D7E5</Color>
    
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- FLYOUT/NAVIGATION COLORS                                             -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    
    <Color x:Key="FlyoutBackgroundColor">#101720</Color>
    <Color x:Key="FlyoutBorderColor">#263342</Color>
    <Color x:Key="FlyoutItemHoverColor">#1B2734</Color>
    <Color x:Key="FlyoutItemActiveColor">#223240</Color>
    
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- BUTTON COLORS                                                        -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    
    <Color x:Key="ButtonTextColor">#06171A</Color>
    <Color x:Key="ButtonBackgroundColor">#66D7E5</Color>
    <Color x:Key="ButtonHoverColor">#8BE4EC</Color>
    <Color x:Key="ButtonPressedColor">#42AFBC</Color>
    
    <Color x:Key="SecondaryButtonBackgroundColor">#1B2633</Color>
    <Color x:Key="SecondaryButtonHoverColor">#243342</Color>
    
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- OVERLAY & BANNER COLORS                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    
    <Color x:Key="OverlayColor">#D90B1017</Color>
    <Color x:Key="OverlayLightColor">#800B1017</Color>
    
    <Color x:Key="WarningBannerColor">#2AF2C66D</Color>
    <Color x:Key="InfoBannerColor">#2483A9F9</Color>
    <Color x:Key="SuccessBannerColor">#2468D6AE</Color>
    <Color x:Key="ErrorBannerColor">#24FF8A9A</Color>
    
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- SHADOW & GLOW COLORS                                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    
    <Color x:Key="ShadowColor">#26000000</Color>
    <Color x:Key="ShadowDeepColor">#40000000</Color>
    <Color x:Key="GlowDownloadColor">#3066D7E5</Color>
    <Color x:Key="GlowUploadColor">#30F0A384</Color>
    <Color x:Key="GlowSuccessColor">#3068D6AE</Color>
    
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- TINTED BACKGROUNDS (for icon containers)                             -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    
    <Color x:Key="DownloadBgTint">#2466D7E5</Color>
    <Color x:Key="UploadBgTint">#24F0A384</Color>
    <Color x:Key="WarningBgTint">#2AF2C66D</Color>
    <Color x:Key="ErrorBgTint">#2AFF8A9A</Color>
    <Color x:Key="AccentBgTint">#1F66D7E5</Color>
    <Color x:Key="SuccessBgTint">#2468D6AE</Color>
    <Color x:Key="InfoBgTint">#2483A9F9</Color>
    
    <!-- Selection colors (for row highlighting) -->
    <Color x:Key="SelectionBgColor">#2266D7E5</Color>
    <Color x:Key="SelectionBorderColor">#5C66D7E5</Color>
    
    <!-- BoxShadow glow color -->
    <Color x:Key="PrimaryGlowColor">#4066D7E5</Color>
    <!-- Accent Brush (used for update notifications) -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource SecondaryColor}" />
    
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariantColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="DownloadBrush" Color="{StaticResource DownloadColor}" />
    <SolidColorBrush x:Key="UploadBrush" Color="{StaticResource UploadColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource GlassBorder}" />
    <SolidColorBrush x:Key="RailBackgroundBrush" Color="{StaticResource RailBackgroundColor}" />
    <SolidColorBrush x:Key="FlyoutItemHoverBrush" Color="{StaticResource FlyoutItemHoverColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource ButtonBackgroundColor}" />
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="{StaticResource SecondaryButtonBackgroundColor}" />
    
    <!-- Tinted background brushes -->
    <SolidColorBrush x:Key="DownloadBgTintBrush" Color="{StaticResource DownloadBgTint}" />
    <SolidColorBrush x:Key="UploadBgTintBrush" Color="{StaticResource UploadBgTint}" />
    <SolidColorBrush x:Key="WarningBgTintBrush" Color="{StaticResource WarningBgTint}" />
    <SolidColorBrush x:Key="ErrorBgTintBrush" Color="{StaticResource ErrorBgTint}" />
    <SolidColorBrush x:Key="AccentBgTintBrush" Color="{StaticResource AccentBgTint}" />
    <SolidColorBrush x:Key="SuccessBgTintBrush" Color="{StaticResource SuccessBgTint}" />
    <SolidColorBrush x:Key="InfoBgTintBrush" Color="{StaticResource InfoBgTint}" />
    
    <!-- Selection brushes -->
    <SolidColorBrush x:Key="SelectionBgBrush" Color="{StaticResource SelectionBgColor}" />
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="{StaticResource SelectionBorderColor}" />

    <!-- The app backdrop is intentionally quiet. Expression lives in the
         selected resource and data, while this gradient supplies depth. -->
    <LinearGradientBrush x:Key="AppBackdropBrush"
                         StartPoint="0%,0%"
                         EndPoint="100%,100%">
        <GradientStop Color="#090E14" Offset="0" />
        <GradientStop Color="#0D1721" Offset="0.55" />
        <GradientStop Color="#111822" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DashboardPanelBrush"
                         StartPoint="0%,0%"
                         EndPoint="100%,100%">
        <GradientStop Color="#171F2A" Offset="0" />
        <GradientStop Color="#121A24" Offset="1" />
    </LinearGradientBrush>
    
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- SYSTEM METRIC BRUSHES                                                -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    
    <!-- CPU Brushes -->
    <SolidColorBrush x:Key="CpuBrush" Color="{StaticResource CpuColor}" />
    <SolidColorBrush x:Key="CpuLightBrush" Color="{StaticResource CpuColorLight}" />
    <SolidColorBrush x:Key="CpuDarkBrush" Color="{StaticResource CpuColorDark}" />
    <SolidColorBrush x:Key="CpuBgTintBrush" Color="{StaticResource CpuBgTint}" />

    <!-- Kernel timing brushes -->
    <SolidColorBrush x:Key="KernelBrush" Color="{StaticResource KernelColor}" />
    <SolidColorBrush x:Key="KernelBgTintBrush" Color="{StaticResource KernelBgTint}" />
    
    <!-- Memory Brushes -->
    <SolidColorBrush x:Key="MemoryBrush" Color="{StaticResource MemoryColor}" />
    <SolidColorBrush x:Key="MemoryLightBrush" Color="{StaticResource MemoryColorLight}" />
    <SolidColorBrush x:Key="MemoryDarkBrush" Color="{StaticResource MemoryColorDark}" />
    <SolidColorBrush x:Key="MemoryBgTintBrush" Color="{StaticResource MemoryBgTint}" />
    
    <!-- GPU Brushes -->
    <SolidColorBrush x:Key="GpuBrush" Color="{StaticResource GpuColor}" />
    <SolidColorBrush x:Key="GpuLightBrush" Color="{StaticResource GpuColorLight}" />
    <SolidColorBrush x:Key="GpuDarkBrush" Color="{StaticResource GpuColorDark}" />
    <SolidColorBrush x:Key="GpuBgTintBrush" Color="{StaticResource GpuBgTint}" />

    <!-- Disk Brushes -->
    <SolidColorBrush x:Key="DiskBrush" Color="{StaticResource DiskColor}" />
    <SolidColorBrush x:Key="DiskLightBrush" Color="{StaticResource DiskColorLight}" />
    <SolidColorBrush x:Key="DiskDarkBrush" Color="{StaticResource DiskColorDark}" />
    <SolidColorBrush x:Key="DiskBgTintBrush" Color="{StaticResource DiskBgTint}" />

</ResourceDictionary>
