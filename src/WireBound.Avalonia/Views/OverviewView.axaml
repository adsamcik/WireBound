<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WireBound.Avalonia.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:controls="using:WireBound.Avalonia.Controls"
             x:Class="WireBound.Avalonia.Views.OverviewView"
             x:DataType="vm:DashboardViewModel"
             Background="Transparent"
             AutomationProperties.Name="Unified resource dashboard">

    <UserControl.Styles>
        <Style Selector="Button.ResourceCard">
            <Setter Property="MinHeight" Value="112" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource DashboardPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.ResourceCard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource FlyoutItemHoverColor}" />
        </Style>
        <Style Selector="Button.ResourceCard.network.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DownloadBgTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DownloadBrush}" />
        </Style>
        <Style Selector="Button.ResourceCard.cpu.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CpuBgTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CpuBrush}" />
        </Style>
        <Style Selector="Button.ResourceCard.memory.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource MemoryBgTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MemoryBrush}" />
        </Style>
        <Style Selector="Button.ResourceCard.disk.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DiskBgTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DiskBrush}" />
        </Style>
        <Style Selector="ListBox.ContributorList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.ContributorList ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="ListBox.ContributorList ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.ContributorRow">
            <Setter Property="Background" Value="{StaticResource SurfaceVariantBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="ComboBox.ViewControl">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Background" Value="{StaticResource SurfaceVariantBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Button.ViewControl">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Background" Value="{StaticResource SurfaceVariantBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="20" MinHeight="610" RowDefinitions="Auto,*,Auto" RowSpacing="14">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,*,*,*"
              ColumnSpacing="10"
              AutomationProperties.Name="Resource summaries">
                <Button Grid.Column="0"
                        Classes="ResourceCard cpu"
                        Classes.selected="{Binding IsCpuFocus}"
                        Command="{Binding SelectResourceCommand}"
                        CommandParameter="{x:Static vm:DashboardResource.Cpu}"
                        AutomationProperties.Name="Focus CPU resource">
                    <Border CornerRadius="17" ClipToBounds="True">
                    <Grid RowDefinitions="*,Auto">
                    <Grid Margin="13,11,13,0" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                            <controls:WbIcon IconKey="WbEntityCpu" Width="16" Height="16" />
                            <TextBlock Grid.Column="1" Text="CPU" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CpuBrush}" />
                            <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="{StaticResource MutedTextBrush}" Margin="0,-4,0,0" />
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding System.CpuUsageFormatted}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="utilized" Classes="Caption" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                        </StackPanel>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding System.ProcessorCount, StringFormat='{}{0} logical processors'}"
                                   Classes="Caption"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                        <controls:MiniSparkline Grid.Row="1"
                                                Height="22"
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Bottom"
                                                Values="{Binding System.CpuHistoryPoints}"
                                                StrokeColor="{StaticResource CpuBrush}"
                                                FillColor="{StaticResource CpuBgTintBrush}"
                                                StrokeThickness="1.6"
                                                MaxPoints="36"
                                                AutomationProperties.Name="Recent CPU activity" />
                    </Grid>
                    </Border>
                </Button>

                <Button Grid.Column="1"
                        Classes="ResourceCard memory"
                        Classes.selected="{Binding IsMemoryFocus}"
                        Command="{Binding SelectResourceCommand}"
                        CommandParameter="{x:Static vm:DashboardResource.Memory}"
                        AutomationProperties.Name="Focus Memory resource">
                    <Border CornerRadius="17" ClipToBounds="True">
                    <Grid RowDefinitions="*,Auto">
                    <Grid Margin="13,11,13,0" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                            <controls:WbIcon IconKey="WbEntityMemory" Width="16" Height="16" />
                            <TextBlock Grid.Column="1" Text="Memory" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MemoryBrush}" />
                            <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="{StaticResource MutedTextBrush}" Margin="0,-4,0,0" />
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding System.MemoryUsed}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="used" Classes="Caption" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="{Binding System.MemoryUsageFormatted}" Classes="Caption" Foreground="{StaticResource MemoryBrush}" />
                            <TextBlock Text="{Binding System.MemoryTotal, StringFormat='of {0}'}" Classes="Caption" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                        <controls:MiniSparkline Grid.Row="1"
                                                Height="22"
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Bottom"
                                                Values="{Binding System.MemoryHistoryPoints}"
                                                StrokeColor="{StaticResource MemoryBrush}"
                                                FillColor="{StaticResource MemoryBgTintBrush}"
                                                StrokeThickness="1.6"
                                                MaxPoints="36"
                                                AutomationProperties.Name="Recent memory activity" />
                    </Grid>
                    </Border>
                </Button>

                <Button Grid.Column="2"
                        Classes="ResourceCard disk"
                        Classes.selected="{Binding IsDiskFocus}"
                        Command="{Binding SelectResourceCommand}"
                        CommandParameter="{x:Static vm:DashboardResource.Disk}"
                        AutomationProperties.Name="Focus Disk resource">
                    <Border CornerRadius="17" ClipToBounds="True">
                    <Grid RowDefinitions="*,Auto">
                    <Grid Margin="13,11,13,0" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                            <controls:WbIcon IconKey="WbNavSystem" Tint="{StaticResource DiskBrush}" Width="16" Height="16" />
                            <TextBlock Grid.Column="1" Text="Disk" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DiskBrush}" />
                            <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="{StaticResource MutedTextBrush}" Margin="0,-4,0,0" />
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding System.DiskRead}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="read" Classes="Caption" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="{Binding System.DiskWrite, StringFormat='↑ {0}'}" Classes="Caption" Foreground="{StaticResource DiskBrush}" />
                            <TextBlock Text="write" Classes="Caption" />
                        </StackPanel>
                    </Grid>
                        <controls:MiniSparkline Grid.Row="1"
                                                Height="22"
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Bottom"
                                                Values="{Binding System.DiskReadHistoryPoints}"
                                                StrokeColor="{StaticResource DiskBrush}"
                                                FillColor="{StaticResource DiskBgTintBrush}"
                                                StrokeThickness="1.6"
                                                MaxPoints="36"
                                                AutomationProperties.Name="Recent disk read activity" />
                    </Grid>
                    </Border>
                </Button>

                <Button Grid.Column="3"
                        Classes="ResourceCard network"
                        Classes.selected="{Binding IsNetworkFocus}"
                        Command="{Binding SelectResourceCommand}"
                        CommandParameter="{x:Static vm:DashboardResource.Network}"
                        AutomationProperties.Name="Focus Network resource">
                    <Border CornerRadius="17" ClipToBounds="True">
                    <Grid RowDefinitions="*,Auto">
                    <Grid Margin="13,11,13,0" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                            <controls:WbIcon IconKey="WbNavLive" Width="16" Height="16" />
                            <TextBlock Grid.Column="1" Text="Network" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DownloadBrush}" />
                            <TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="{StaticResource MutedTextBrush}" Margin="0,-4,0,0" />
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Network.DownloadSpeed}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="down" Classes="Caption" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="{Binding Network.UploadSpeed, StringFormat='↑ {0}'}" Classes="Caption" Foreground="{StaticResource UploadBrush}" />
                            <TextBlock Text="upload" Classes="Caption" />
                        </StackPanel>
                    </Grid>
                        <controls:MiniSparkline Grid.Row="1"
                                                Height="22"
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Bottom"
                                                Values="{Binding Network.DownloadSparklineValues}"
                                                StrokeColor="{StaticResource DownloadBrush}"
                                                FillColor="{StaticResource DownloadBgTintBrush}"
                                                StrokeThickness="1.6"
                                                MaxPoints="36"
                                                AutomationProperties.Name="Recent network download activity" />
                    </Grid>
                    </Border>
                </Button>
        </Grid>

        <Grid x:Name="DashboardContentGrid"
              Grid.Row="1"
              ColumnDefinitions="2.2*,*"
              RowDefinitions="*"
              ColumnSpacing="14">
            <Border x:Name="ActivityPanel"
                    Grid.Column="0"
                    Background="{StaticResource DashboardPanelBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="26"
                    Padding="22"
                    BoxShadow="0 10 28 0 #26000000">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="LIVE ACTIVITY" Classes="MetricLabel" FontSize="10" Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Text="{Binding FocusTitle}" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding FocusSubtitle}" Classes="Subtitle" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="Ghost ToolbarButton"
                                Command="{Binding OpenResourceDetailsCommand}"
                                ToolTip.Tip="Open resource details"
                                AutomationProperties.Name="Open focused resource details">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:WbIcon IconKey="WbMetricAnalytics" Width="16" Height="16" />
                                <TextBlock Text="Open details" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <TextBlock Text="VIEW"
                                   Classes="MetricLabel"
                                   FontSize="10"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    AutomationProperties.Name="Chart view controls">
                            <ComboBox Classes="ViewControl"
                                      Width="84"
                                      ItemsSource="{Binding TimeRangeOptions}"
                                      SelectedItem="{Binding SelectedTimeRangeOption}"
                                      ToolTip.Tip="Time range"
                                      AutomationProperties.Name="Time range">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TimeRangeDisplayItem">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox Classes="ViewControl"
                                      Width="136"
                                      IsVisible="{Binding HasSignalChoices}"
                                      ItemsSource="{Binding SignalOptions}"
                                      SelectedItem="{Binding SelectedSignal}"
                                      ToolTip.Tip="Metric shown on the chart"
                                      AutomationProperties.Name="Resource signal" />
                            <ComboBox Classes="ViewControl"
                                      Width="132"
                                      IsVisible="{Binding HasProcessAttribution}"
                                      ItemsSource="{Binding ProcessScopeOptions}"
                                      SelectedItem="{Binding SelectedProcessScope}"
                                      ToolTip.Tip="Processes included in attribution"
                                      AutomationProperties.Name="Process scope" />
                            <Button Classes="ViewControl"
                                    IsVisible="{Binding HasContextFilters}"
                                    ToolTip.Tip="Choose network adapter"
                                    AutomationProperties.Name="Choose network adapter">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <Border MinWidth="320"
                                                Padding="14"
                                                Background="{StaticResource SurfaceElevatedBrush}"
                                                BorderBrush="{StaticResource GlassBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="16">
                                            <StackPanel Spacing="10">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Network adapter" FontWeight="SemiBold" />
                                                    <TextBlock Text="Limit live activity to one interface." Classes="Caption" />
                                                </StackPanel>
                                                <ComboBox ItemsSource="{Binding Network.Adapters}"
                                                          SelectedItem="{Binding Network.SelectedAdapter}"
                                                          AutomationProperties.Name="Network adapter">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:AdapterDisplayItem">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <controls:WbIcon IconKey="{Binding TypeIconKey}" Width="15" Height="15" />
                                                                <TextBlock Text="{Binding DisplayName}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <controls:WbIcon IconKey="WbActionTune" Width="15" Height="15" />
                                    <TextBlock Text="Adapter" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2"
                            MinHeight="300"
                            Background="{StaticResource SurfaceVariantBrush}"
                            CornerRadius="20"
                            Padding="8,14,8,4">
                    <Grid>
                        <lvc:CartesianChart IsVisible="{Binding IsNetworkFocus}"
                                            Series="{Binding NetworkSeries}"
                                            XAxes="{Binding Network.ChartXAxes}"
                                            YAxes="{Binding Network.ChartYAxes}"
                                            LegendPosition="Bottom"
                                            AnimationsSpeed="0:0:0.15"
                                            AutomationProperties.Name="Network activity chart" />
                        <lvc:CartesianChart IsVisible="{Binding IsCpuFocus}"
                                            Series="{Binding System.CpuSeries}"
                                            XAxes="{Binding System.CpuXAxes}"
                                            YAxes="{Binding System.CpuYAxes}"
                                            LegendPosition="Hidden"
                                            AnimationsSpeed="0:0:0.15"
                                            AutomationProperties.Name="CPU activity chart" />
                        <lvc:CartesianChart IsVisible="{Binding IsMemoryFocus}"
                                            Series="{Binding System.MemorySeries}"
                                            XAxes="{Binding System.MemoryXAxes}"
                                            YAxes="{Binding System.MemoryYAxes}"
                                            LegendPosition="Hidden"
                                            AnimationsSpeed="0:0:0.15"
                                            AutomationProperties.Name="Memory activity chart" />
                        <lvc:CartesianChart IsVisible="{Binding IsDiskFocus}"
                                            Series="{Binding DiskSeries}"
                                            XAxes="{Binding System.DiskXAxes}"
                                            YAxes="{Binding System.DiskYAxes}"
                                            LegendPosition="Bottom"
                                            AnimationsSpeed="0:0:0.15"
                                            AutomationProperties.Name="Disk activity chart" />
                    </Grid>
                    </Border>

                </Grid>
            </Border>

            <Border x:Name="CausePanel"
                    Grid.Column="1"
                    Background="{StaticResource DashboardPanelBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="26"
                    Padding="20"
                    BoxShadow="0 10 28 0 #26000000">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="RESOURCE IMPACT" Classes="MetricLabel" FontSize="10" Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Text="{Binding ContributorsTitle}" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ContributorsSubtitle}" Classes="Caption" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="Ghost ToolbarButton"
                                Command="{Binding OpenProcessesCommand}"
                                IsVisible="{Binding !IsDiskFocus}"
                                ToolTip.Tip="Open Processes sorted by this resource"
                                AutomationProperties.Name="Open Processes sorted by focused resource">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <controls:WbIcon IconKey="WbNavApps" Width="15" Height="15" />
                                <TextBlock Text="View all" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1"
                                Classes="Ghost ToolbarButton"
                                Command="{Binding OpenResourceDetailsCommand}"
                                IsVisible="{Binding IsDiskFocus}"
                                AutomationProperties.Name="Open Disk details">
                            <TextBlock Text="View details" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox Classes="ContributorList"
                                 IsVisible="{Binding IsNetworkFocus}"
                                 ItemsSource="{Binding TopContributors}"
                                 AutomationProperties.Name="Processes using the most network bandwidth">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProcessUsageDisplayItem">
                                    <Border Classes="ContributorRow">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource DownloadBgTintBrush}" VerticalAlignment="Center">
                                                <controls:WbIcon IconKey="WbEntityApp" Width="16" Height="16" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ProcessIdLabel}" Classes="Caption" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DownloadDisplay, StringFormat='↓ {0}'}" Foreground="{StaticResource DownloadBrush}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding UploadDisplay, StringFormat='↑ {0}'}" Foreground="{StaticResource UploadBrush}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox Classes="ContributorList"
                                 IsVisible="{Binding IsCpuFocus}"
                                 ItemsSource="{Binding TopContributors}"
                                 AutomationProperties.Name="Processes using the most CPU">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProcessUsageDisplayItem">
                                    <Border Classes="ContributorRow">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource CpuBgTintBrush}" VerticalAlignment="Center">
                                                <controls:WbIcon IconKey="WbEntityApp" Width="16" Height="16" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ProcessIdLabel}" Classes="Caption" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding CpuDisplay}" Foreground="{StaticResource CpuBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox Classes="ContributorList"
                                 IsVisible="{Binding IsMemoryFocus}"
                                 ItemsSource="{Binding TopContributors}"
                                 AutomationProperties.Name="Processes using the most memory">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProcessUsageDisplayItem">
                                    <Border Classes="ContributorRow">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource MemoryBgTintBrush}" VerticalAlignment="Center">
                                                <controls:WbIcon IconKey="WbEntityApp" Width="16" Height="16" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ProcessIdLabel}" Classes="Caption" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding MemoryDisplay}" Foreground="{StaticResource MemoryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel IsVisible="{Binding IsDiskFocus}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="280"
                                    Spacing="10">
                            <controls:WbIcon IconKey="WbNavSystem" Tint="{StaticResource DiskBrush}" Width="34" Height="34" HorizontalAlignment="Center" />
                            <TextBlock Text="Per-process disk attribution is not available from every operating system." TextWrapping="Wrap" TextAlignment="Center" Classes="Subtitle" />
                            <TextBlock Text="The disk chart remains accurate; open details for drive-level activity." TextWrapping="Wrap" TextAlignment="Center" Classes="Caption" />
                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>
        </Grid>

        <!-- Per-core charts are shown when CPU is the focused resource. -->
        <Border Grid.Row="2"
                IsVisible="{Binding IsCpuFocus}"
                Background="{StaticResource DashboardPanelBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="26"
                Padding="20"
                BoxShadow="0 10 28 0 #26000000"
                AutomationProperties.Name="Per-core CPU charts">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="14">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Width="34"
                            Height="34"
                            Background="{StaticResource CpuBgTintBrush}"
                            CornerRadius="11">
                        <controls:WbIcon IconKey="WbEntityCores" Width="16" Height="16" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="PER-CORE CPU" Classes="MetricLabel" FontSize="10" Foreground="{StaticResource CpuBrush}" />
                        <TextBlock Text="Last 60 seconds by logical processor" Classes="Caption" />
                    </StackPanel>
                    <ToggleButton Grid.Column="2"
                                  IsChecked="{Binding Network.ShowKernelTimings}"
                                  IsVisible="{Binding Network.IsKernelTimingAvailable}"
                                  Padding="10,6"
                                  ToolTip.Tip="Highlight privileged/kernel CPU time on every core"
                                  AutomationProperties.Name="Highlight kernel CPU time">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="{StaticResource KernelBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Network.KernelUsageFormatted}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Network.CpuCoreCharts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CpuCoreChartItem">
                            <Border Width="190"
                                    Height="94"
                                    Margin="0,0,10,10"
                                    Padding="10,8"
                                    CornerRadius="12"
                                    Background="{StaticResource SurfaceVariantBrush}">
                                <Grid RowDefinitions="Auto,*">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Label}"
                                                   Classes="MetricLabel"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding KernelFormatted}"
                                                       IsVisible="{Binding ShowKernelHighlight}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource KernelBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding UsageFormatted}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource CpuBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1" Height="48" Margin="0,6,0,0">
                                        <controls:MiniSparkline Values="{Binding UsageHistory}"
                                                                MaxPoints="60"
                                                                MinValue="0"
                                                                MaxValue="100"
                                                                StrokeColor="{StaticResource CpuBrush}"
                                                                FillColor="{StaticResource CpuBgTintBrush}"
                                                                StrokeThickness="1.5"
                                                                AutomationProperties.Name="{Binding AccessibilityName}" />
                                        <controls:MiniSparkline Values="{Binding KernelHistory}"
                                                                MaxPoints="60"
                                                                MinValue="0"
                                                                MaxValue="100"
                                                                StrokeColor="{StaticResource KernelBrush}"
                                                                FillColor="{StaticResource KernelBgTintBrush}"
                                                                StrokeThickness="1.5"
                                                                IsVisible="{Binding ShowKernelHighlight}"
                                                                IsHitTestVisible="False" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
