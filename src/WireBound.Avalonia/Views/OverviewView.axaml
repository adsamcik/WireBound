<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WireBound.Avalonia.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:controls="using:WireBound.Avalonia.Controls"
             x:Class="WireBound.Avalonia.Views.OverviewView"
             x:DataType="vm:DashboardViewModel"
             Background="Transparent"
             AutomationProperties.Name="Unified resource dashboard">

    <UserControl.Styles>
        <Style Selector="Button.ResourceCard">
            <Setter Property="MinHeight" Value="82" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.ResourceCard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource FlyoutItemHoverColor}" />
        </Style>
        <Style Selector="Button.ResourceCard.network.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DownloadBgTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DownloadBrush}" />
        </Style>
        <Style Selector="Button.ResourceCard.cpu.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CpuBgTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CpuBrush}" />
        </Style>
        <Style Selector="Button.ResourceCard.memory.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource MemoryBgTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MemoryBrush}" />
        </Style>
        <Style Selector="Button.ResourceCard.disk.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DiskBgTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DiskBrush}" />
        </Style>
        <Style Selector="ListBox.ContributorList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.ContributorList ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="ListBox.ContributorList ListBoxItem /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.ContributorRow">
            <Setter Property="Background" Value="{StaticResource SurfaceVariantBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="20" MinHeight="610" RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceVariantBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="26"
                Padding="6"
                BoxShadow="0 8 24 0 #22000000"
                AutomationProperties.Name="Resource focus">
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                <Button Grid.Column="0"
                        Classes="ResourceCard network"
                        Classes.selected="{Binding IsNetworkFocus}"
                        Command="{Binding SelectResourceCommand}"
                        CommandParameter="{x:Static vm:DashboardResource.Network}"
                        AutomationProperties.Name="Focus Network resource">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Width="44" Height="44" CornerRadius="15" Background="{StaticResource DownloadBgTintBrush}">
                            <controls:WbIcon IconKey="WbNavLive" Width="22" Height="22" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Network" FontSize="15" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Network.DownloadSpeed, StringFormat='↓ {0}'}" FontSize="12" Foreground="{StaticResource DownloadBrush}" />
                                <TextBlock Text="{Binding Network.UploadSpeed, StringFormat='↑ {0}'}" FontSize="12" Foreground="{StaticResource UploadBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Grid.Column="1"
                        Classes="ResourceCard cpu"
                        Classes.selected="{Binding IsCpuFocus}"
                        Command="{Binding SelectResourceCommand}"
                        CommandParameter="{x:Static vm:DashboardResource.Cpu}"
                        AutomationProperties.Name="Focus CPU resource">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Width="44" Height="44" CornerRadius="15" Background="{StaticResource CpuBgTintBrush}">
                            <controls:WbIcon IconKey="WbEntityCpu" Width="22" Height="22" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="CPU" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding System.CpuUsageFormatted}" FontSize="12" Foreground="{StaticResource CpuBrush}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Grid.Column="2"
                        Classes="ResourceCard memory"
                        Classes.selected="{Binding IsMemoryFocus}"
                        Command="{Binding SelectResourceCommand}"
                        CommandParameter="{x:Static vm:DashboardResource.Memory}"
                        AutomationProperties.Name="Focus Memory resource">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Width="44" Height="44" CornerRadius="15" Background="{StaticResource MemoryBgTintBrush}">
                            <controls:WbIcon IconKey="WbEntityMemory" Width="22" Height="22" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Memory" FontSize="15" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding System.MemoryUsageFormatted}" FontSize="12" Foreground="{StaticResource MemoryBrush}" />
                                <TextBlock Text="{Binding System.MemoryUsed, StringFormat='{}{0} used'}" Classes="Caption" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Grid.Column="3"
                        Classes="ResourceCard disk"
                        Classes.selected="{Binding IsDiskFocus}"
                        Command="{Binding SelectResourceCommand}"
                        CommandParameter="{x:Static vm:DashboardResource.Disk}"
                        AutomationProperties.Name="Focus Disk resource">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Width="44" Height="44" CornerRadius="15" Background="{StaticResource DiskBgTintBrush}">
                            <controls:WbIcon IconKey="WbNavSystem" Tint="{StaticResource DiskBrush}" Width="22" Height="22" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Disk" FontSize="15" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding System.DiskRead, StringFormat='↓ {0}'}" FontSize="12" Foreground="{StaticResource DiskBrush}" />
                                <TextBlock Text="{Binding System.DiskWrite, StringFormat='↑ {0}'}" Classes="Caption" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                IsVisible="{Binding IsFilterPanelVisible}"
                Background="{StaticResource SurfaceElevatedBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="12,8"
                AutomationProperties.Name="Dashboard filters">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <TextBlock Text="Network adapter" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Network.Adapters}"
                          SelectedItem="{Binding Network.SelectedAdapter}"
                          MinWidth="260"
                          AutomationProperties.Name="Network adapter">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AdapterDisplayItem">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:WbIcon IconKey="{Binding TypeIconKey}" Width="15" Height="15" />
                                <TextBlock Text="{Binding DisplayName}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>

        <Grid x:Name="DashboardContentGrid"
              Grid.Row="2"
              ColumnDefinitions="2.2*,*"
              RowDefinitions="*"
              ColumnSpacing="14">
            <Border x:Name="ActivityPanel"
                    Grid.Column="0"
                    Background="{StaticResource DashboardPanelBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="26"
                    Padding="22"
                    BoxShadow="0 10 28 0 #26000000">
                <Grid RowDefinitions="Auto,*" RowSpacing="14">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="LIVE ACTIVITY" Classes="MetricLabel" FontSize="10" Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Text="{Binding FocusTitle}" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding FocusSubtitle}" Classes="Subtitle" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="Ghost ToolbarButton"
                                Command="{Binding OpenResourceDetailsCommand}"
                                AutomationProperties.Name="Open focused resource details">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:WbIcon IconKey="WbMetricAnalytics" Width="16" Height="16" />
                                <TextBlock Text="Open details" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1"
                            MinHeight="300"
                            Background="{StaticResource SurfaceVariantBrush}"
                            CornerRadius="20"
                            Padding="8,14,8,4">
                    <Grid>
                        <lvc:CartesianChart IsVisible="{Binding IsNetworkFocus}"
                                            Series="{Binding NetworkSeries}"
                                            XAxes="{Binding Network.ChartXAxes}"
                                            YAxes="{Binding Network.ChartYAxes}"
                                            LegendPosition="Bottom"
                                            AnimationsSpeed="0:0:0.15"
                                            AutomationProperties.Name="Network activity chart" />
                        <lvc:CartesianChart IsVisible="{Binding IsCpuFocus}"
                                            Series="{Binding System.CpuSeries}"
                                            XAxes="{Binding System.CpuXAxes}"
                                            YAxes="{Binding System.CpuYAxes}"
                                            LegendPosition="Hidden"
                                            AnimationsSpeed="0:0:0.15"
                                            AutomationProperties.Name="CPU activity chart" />
                        <lvc:CartesianChart IsVisible="{Binding IsMemoryFocus}"
                                            Series="{Binding System.MemorySeries}"
                                            XAxes="{Binding System.MemoryXAxes}"
                                            YAxes="{Binding System.MemoryYAxes}"
                                            LegendPosition="Hidden"
                                            AnimationsSpeed="0:0:0.15"
                                            AutomationProperties.Name="Memory activity chart" />
                        <lvc:CartesianChart IsVisible="{Binding IsDiskFocus}"
                                            Series="{Binding DiskSeries}"
                                            XAxes="{Binding System.DiskXAxes}"
                                            YAxes="{Binding System.DiskYAxes}"
                                            LegendPosition="Bottom"
                                            AnimationsSpeed="0:0:0.15"
                                            AutomationProperties.Name="Disk activity chart" />
                    </Grid>
                    </Border>

                </Grid>
            </Border>

            <Border x:Name="CausePanel"
                    Grid.Column="1"
                    Background="{StaticResource DashboardPanelBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="26"
                    Padding="20"
                    BoxShadow="0 10 28 0 #26000000">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Text="RESOURCE IMPACT" Classes="MetricLabel" FontSize="10" Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Text="{Binding ContributorsTitle}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ContributorsSubtitle}" Classes="Caption" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <ListBox Classes="ContributorList"
                                 IsVisible="{Binding IsNetworkFocus}"
                                 ItemsSource="{Binding TopContributors}"
                                 AutomationProperties.Name="Processes using the most network bandwidth">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProcessUsageDisplayItem">
                                    <Border Classes="ContributorRow">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource DownloadBgTintBrush}" VerticalAlignment="Center">
                                                <controls:WbIcon IconKey="WbEntityApp" Width="16" Height="16" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ProcessIdLabel}" Classes="Caption" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DownloadDisplay, StringFormat='↓ {0}'}" Foreground="{StaticResource DownloadBrush}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding UploadDisplay, StringFormat='↑ {0}'}" Foreground="{StaticResource UploadBrush}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox Classes="ContributorList"
                                 IsVisible="{Binding IsCpuFocus}"
                                 ItemsSource="{Binding TopContributors}"
                                 AutomationProperties.Name="Processes using the most CPU">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProcessUsageDisplayItem">
                                    <Border Classes="ContributorRow">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource CpuBgTintBrush}" VerticalAlignment="Center">
                                                <controls:WbIcon IconKey="WbEntityApp" Width="16" Height="16" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ProcessIdLabel}" Classes="Caption" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding CpuDisplay}" Foreground="{StaticResource CpuBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox Classes="ContributorList"
                                 IsVisible="{Binding IsMemoryFocus}"
                                 ItemsSource="{Binding TopContributors}"
                                 AutomationProperties.Name="Processes using the most memory">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProcessUsageDisplayItem">
                                    <Border Classes="ContributorRow">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource MemoryBgTintBrush}" VerticalAlignment="Center">
                                                <controls:WbIcon IconKey="WbEntityApp" Width="16" Height="16" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ProcessIdLabel}" Classes="Caption" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding MemoryDisplay}" Foreground="{StaticResource MemoryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel IsVisible="{Binding IsDiskFocus}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="280"
                                    Spacing="10">
                            <controls:WbIcon IconKey="WbNavSystem" Tint="{StaticResource DiskBrush}" Width="34" Height="34" HorizontalAlignment="Center" />
                            <TextBlock Text="Per-process disk attribution is not available from every operating system." TextWrapping="Wrap" TextAlignment="Center" Classes="Subtitle" />
                            <TextBlock Text="The disk chart remains accurate; open details for drive-level activity." TextWrapping="Wrap" TextAlignment="Center" Classes="Caption" />
                        </StackPanel>
                    </Grid>

                    <Button Grid.Row="2"
                            Classes="Secondary ToolbarButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding OpenProcessesCommand}"
                            IsVisible="{Binding !IsDiskFocus}"
                            AutomationProperties.Name="Open Processes sorted by focused resource">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:WbIcon IconKey="WbNavApps" Width="16" Height="16" />
                            <TextBlock Text="Open Processes" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="2"
                            Classes="Secondary ToolbarButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding OpenResourceDetailsCommand}"
                            IsVisible="{Binding IsDiskFocus}"
                            AutomationProperties.Name="Open Disk details">
                        <TextBlock Text="Open Disk details" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
