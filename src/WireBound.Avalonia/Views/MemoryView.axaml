<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WireBound.Avalonia.ViewModels"
             xmlns:controls="using:WireBound.Avalonia.Controls"
             xmlns:converters="using:WireBound.Avalonia.Converters"
             x:Class="WireBound.Avalonia.Views.MemoryView"
             x:DataType="vm:MemoryViewModel"
             Background="{StaticResource BackgroundBrush}"
             AutomationProperties.Name="Memory details">
    <UserControl.Resources>
        <ControlTheme x:Key="MemorySegmentButtonTheme" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" ClipToBounds="True">
                        <Grid>
                            <Border BorderBrush="{StaticResource SurfaceBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False" />
                            <Border Name="SegmentSurface" BorderBrush="Transparent" BorderThickness="2" Padding="{TemplateBinding Padding}">
                                <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#SegmentSurface">
                <Setter Property="BorderBrush" Value="{Binding $parent[Button].Foreground}" />
            </Style>
            <Style Selector="^.selected /template/ Border#SegmentSurface">
                <Setter Property="BorderBrush" Value="{Binding $parent[Button].Foreground}" />
            </Style>
            <Style Selector="^:focus-visible /template/ Border#SegmentSurface">
                <Setter Property="BorderBrush" Value="{Binding $parent[Button].Foreground}" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="ListBox#ConsumerList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox#ConsumerList ListBoxItem">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.Disclosure">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="20" />
        </Style>
    </UserControl.Styles>
    <Grid Margin="20,16" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <TextBlock Text="Memory" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding SampleStatus}" Classes="Caption" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="Secondary ToolbarButton" Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding !IsLoading}" AutomationProperties.Name="Refresh memory details" Content="Refresh" />
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="16,10">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="9">
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                    <StackPanel Spacing="2">
                        <TextBlock Text="In use" Classes="Caption" />
                        <TextBlock Text="{Binding InUse}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource MemoryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Available" Classes="Caption" />
                        <TextBlock Text="{Binding Available}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="Hardware reserved" Classes="Caption" />
                        <TextBlock Text="{Binding HardwareReserved}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="2">
                        <TextBlock Text="Installed" Classes="Caption" />
                        <TextBlock Text="{Binding Installed}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" CornerRadius="6" ClipToBounds="True" Background="{StaticResource BorderSubtleBrush}">
                    <Grid MinHeight="40">
                        <Grid x:Name="MemoryCapacityBar" AutomationProperties.Name="Physical RAM by consumer" />
                        <TextBlock Text="Breakdown unavailable" IsVisible="{Binding !HasMemorySegments}"
                                   Classes="Caption" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="14" ClipToBounds="True">
            <Grid RowDefinitions="Auto,Auto,*,Auto" MinHeight="0">
                <Grid Margin="12,10" ColumnDefinitions="*,260" ColumnSpacing="16">
                    <TextBlock Text="Memory consumers" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding SearchText}" PlaceholderText="Find app, VM, container or PID"
                             AutomationProperties.Name="Filter memory consumers" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,130,210" ColumnSpacing="12" Margin="16,0,28,6">
                    <TextBlock Text="Consumer" Classes="Caption" />
                    <TextBlock Grid.Column="1" Text="RAM ↓" Classes="Caption" HorizontalAlignment="Right"
                               ToolTip.Tip="Descending usage: complete private or system RAM when measured; otherwise reported working-set, VM or container usage. Partial private measurements remain in details." />
                    <TextBlock Grid.Column="2" Text="Measurement" Classes="Caption"
                               ToolTip.Tip="Reported working sets, VM assignments and container usage may overlap physical RAM. These rows are not added to physical totals." />
                </Grid>
                <Grid Grid.Row="2" MinHeight="0">
                    <ListBox x:Name="ConsumerList" ItemsSource="{Binding Consumers}" SelectedItem="{Binding SelectedConsumer}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Memory consumers sorted by RAM usage">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MemoryConsumerRow">
                                <Grid ColumnDefinitions="*,130,210" ColumnSpacing="12" Margin="0,3,12,3" Background="Transparent" ToolTip.Tip="{Binding MeasurementDetails}">
                                    <Grid ColumnDefinitions="28,20,*,Auto" Margin="{Binding Indent}" ColumnSpacing="6">
                                        <Button Classes="Disclosure" IsVisible="{Binding CanExpand}" IsEnabled="{Binding CanToggle}" Content="{Binding ExpandGlyph}"
                                                Command="{Binding $parent[UserControl].((vm:MemoryViewModel)DataContext).ToggleConsumerCommand}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding ExpandName}" />
                                        <Grid Grid.Column="1" Width="20" Height="20" VerticalAlignment="Center">
                                            <Image x:Name="ConsumerIcon" Source="{Binding IconPath, Converter={x:Static converters:IconPathToBitmapConverter.Instance}}"
                                                   Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                            <controls:WbIcon IconKey="{Binding IconKey}" Width="20" Height="20"
                                                             IsVisible="{Binding #ConsumerIcon.Source, Converter={x:Static ObjectConverters.IsNull}}" />
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Summary}" IsVisible="{Binding HasDistinctSummary}"
                                                   Classes="Caption" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding UsageDisplay}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding UsageMetric}" Classes="Caption"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No matching consumers" IsVisible="{Binding HasNoResults}" Classes="Caption"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderSubtleBrush}" Padding="14,9"
                        IsVisible="{Binding HasFooterContent}">
                    <StackPanel Spacing="7">
                        <TextBlock Text="{Binding AccountingStatus}" IsVisible="{Binding HasAccountingStatus}"
                                   Classes="Caption" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding HasSelection}">
                            <ScrollViewer MaxHeight="84" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                          Focusable="True" AutomationProperties.Name="Selected memory consumer details">
                                <TextBlock Text="{Binding SelectedConsumer.MeasurementDetails}" Classes="Caption" TextWrapping="Wrap" />
                            </ScrollViewer>
                            <Button Grid.Column="1" Classes="Secondary" Content="Related processes" IsVisible="{Binding SelectedConsumer.CanLink}"
                                    Command="{Binding ViewRelatedProcessesCommand}" AutomationProperties.Name="View related processes" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding ActionStatus}" IsVisible="{Binding HasActionStatus}"
                                   Classes="Caption" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
