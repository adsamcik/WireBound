<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WireBound.Avalonia.ViewModels"
             x:Class="WireBound.Avalonia.Views.MemoryView"
             x:DataType="vm:MemoryViewModel"
             Background="{StaticResource BackgroundBrush}"
             AutomationProperties.Name="Memory details">
    <UserControl.Resources>
        <ControlTheme x:Key="MemorySegmentButtonTheme" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="SegmentSurface" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#SegmentSurface">
                <Setter Property="BorderBrush" Value="{Binding $parent[Button].Foreground}" />
            </Style>
            <Style Selector="^.selected /template/ Border#SegmentSurface">
                <Setter Property="BorderBrush" Value="{Binding $parent[Button].Foreground}" />
                <Setter Property="BorderThickness" Value="2" />
            </Style>
            <Style Selector="^:focus-visible /template/ Border#SegmentSurface">
                <Setter Property="BorderBrush" Value="{Binding $parent[Button].Foreground}" />
                <Setter Property="BorderThickness" Value="2" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="ListBox#ConsumerList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox#ConsumerList ListBoxItem">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.Disclosure">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="20" />
        </Style>
    </UserControl.Styles>
    <Grid Margin="20,16" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <TextBlock Text="Memory" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding SampleStatus}" Classes="Caption" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="Secondary ToolbarButton" Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding !IsLoading}" AutomationProperties.Name="Refresh memory details" Content="Refresh" />
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="16,10">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="9">
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                    <StackPanel Spacing="2">
                        <TextBlock Text="In use" Classes="Caption" />
                        <TextBlock Text="{Binding InUse}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource MemoryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Available" Classes="Caption" />
                        <TextBlock Text="{Binding Available}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="Hardware reserved" Classes="Caption" />
                        <TextBlock Text="{Binding HardwareReserved}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="2">
                        <TextBlock Text="Installed" Classes="Caption" />
                        <TextBlock Text="{Binding Installed}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" CornerRadius="6" ClipToBounds="True" Background="{StaticResource BorderSubtleBrush}">
                    <Grid MinHeight="28">
                        <Grid x:Name="MemoryCapacityBar" AutomationProperties.Name="Physical RAM by consumer" />
                        <TextBlock Text="Breakdown unavailable" IsVisible="{Binding !HasMemorySegments}"
                                   Classes="Caption" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="14" ClipToBounds="True">
            <Grid RowDefinitions="Auto,Auto,*,Auto" MinHeight="0">
                <Grid Margin="12,10" ColumnDefinitions="*,260" ColumnSpacing="16">
                    <TextBlock Text="Memory consumers" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding SearchText}" PlaceholderText="Find app, VM, container or PID"
                             AutomationProperties.Name="Filter memory consumers" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,130,210" ColumnSpacing="12" Margin="16,0,28,6">
                    <TextBlock Text="Consumer" Classes="Caption" />
                    <TextBlock Grid.Column="1" Text="Physical RAM" Classes="Caption" HorizontalAlignment="Right"
                               ToolTip.Tip="Measured exclusive resident pages. System rows show measured kernel RAM and the remaining shared or unattributed RAM." />
                    <TextBlock Grid.Column="2" Text="Other measurement" Classes="Caption" HorizontalAlignment="Right"
                               ToolTip.Tip="Working sets, VM assignments, and container usage can overlap. These values are not added to physical totals." />
                </Grid>
                <Grid Grid.Row="2" MinHeight="0">
                    <ListBox x:Name="ConsumerList" ItemsSource="{Binding Consumers}" SelectedItem="{Binding SelectedConsumer}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Grouped memory consumers">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:MemoryConsumerRow">
                                <Grid ColumnDefinitions="*,130,210" ColumnSpacing="12" Margin="0,3,12,3" ToolTip.Tip="{Binding Detail}">
                                    <Grid ColumnDefinitions="28,*,Auto" Margin="{Binding Indent}" ColumnSpacing="5">
                                        <Button Classes="Disclosure" IsVisible="{Binding CanExpand}" IsEnabled="{Binding CanToggle}" Content="{Binding ExpandGlyph}"
                                                Command="{Binding $parent[UserControl].((vm:MemoryViewModel)DataContext).ToggleConsumerCommand}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding ExpandName}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Summary}" Classes="Caption" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{Binding PhysicalDisplay}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        <Border Width="{Binding BarWidth}" Height="2" CornerRadius="1" HorizontalAlignment="Right"
                                                Background="{StaticResource MemoryBrush}" />
                                    </StackPanel>
                                    <Grid Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Metric}" Classes="Caption" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding ObservedDisplay}" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No matching consumers" IsVisible="{Binding HasNoResults}" Classes="Caption"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderSubtleBrush}" Padding="14,9">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="7">
                        <TextBlock Text="{Binding AccountingStatus}"
                                   Classes="Caption" TextWrapping="Wrap" />
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding HasSelection}">
                            <ScrollViewer MaxHeight="84" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                          Focusable="True" AutomationProperties.Name="Selected memory consumer details">
                                <TextBlock Text="{Binding SelectedConsumer.Detail}" Classes="Caption" TextWrapping="Wrap" />
                            </ScrollViewer>
                            <Button Grid.Column="1" Classes="Secondary" Content="Related processes" IsVisible="{Binding SelectedConsumer.CanLink}"
                                    Command="{Binding ViewRelatedProcessesCommand}" AutomationProperties.Name="View related processes" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
